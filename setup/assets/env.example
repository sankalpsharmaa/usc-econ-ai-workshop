# Copy this file to .env and fill in the keys you need.
#
#     cp .env.example .env
#
# .env is gitignored. Never commit real keys --- if one lands in a commit it is
# in the history permanently, and pushing it to GitHub means it is public even
# if you delete it a minute later.

# Neil's labelling demos (Neil/llm_labeling_demo.py and the notebook).
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Only needed if you are using Claude Code with an API key rather than
# signing in through the browser. Pro/Max/Team subscribers can leave it blank.
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
